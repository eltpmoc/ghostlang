#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
EXTRA=(-include "$ROOT/ia_propria/backend/ponte.hpp")
if [[ ${IA_LINK_CUDA:-0} == 1 ]]; then
    EXTRA+=(-DIA_COM_CUDA "${IA_CUDA_OBJECT:?}" "${IA_CUDA_HOME:?}/lib64/libcudart_static.a" -ldl -lrt -pthread)
fi
exec "${GHOST_CXX:?Defina GHOST_CXX}" "$@" -std=c++17 \
    -I"$ROOT" -I"$ROOT/include" "$ROOT/src/GhostNumberG.cpp" "${EXTRA[@]}"
