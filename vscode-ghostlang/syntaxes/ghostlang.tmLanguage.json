{
  "name": "GhostLang",
  "scopeName": "source.ghost",
  "fileTypes": [
    "g",
    "ghost"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#keywords-quantum"
    },
    {
      "include": "#keywords-http"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#method-call"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ghost",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ghost",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ghost",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ghost",
          "match": "\\\\."
        }
      ]
    },
    "keywords-control": {
      "name": "keyword.control.ghost",
      "match": "\\b(if|else|for|while|do|foreach|in|switch|case|default|break|continue|return|try|catch|throw|finally)\\b"
    },
    "keywords-declaration": {
      "name": "keyword.other.declaration.ghost",
      "match": "\\b(function|var|import|load|class|interface|public|private|this|new|extends|super|pragma|gpu|print|println|printf|imprimir|escreva|escrevaln|input|inputln|show)\\b"
    },
    "keywords-quantum": {
      "name": "support.class.quantum.ghost",
      "match": "\\b(state|gate|qreg|qcircuit|qlayer|circuit|hadamard|paulix|pauliy|pauliz|hypothesis|collapse_max|collapse_min|transpose|conv|network|optimize|activate|apply|relu|sigmoid|sin|cos|tan|epochs|lr|opt|textmodel|llm|load_gguf|swarm|matrix|GhostMatrix|spawn|sleep|mutex|lock|unlock)\\b"
    },
    "keywords-http": {
      "name": "support.function.http.ghost",
      "match": "\\b(server|route|listen)\\b"
    },
    "types": {
      "name": "storage.type.ghost",
      "match": "\\b(string|int|double|float|complex|void|ghost|json|date|time|datetime|bool|list|map)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ghost",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "comment": "function keyword + return type + name",
          "match": "\\b(function)\\s+\\b(string|int|double|float|complex|void|ghost|json|date|time|datetime|bool|list|map)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "keyword.other.declaration.ghost"
            },
            "2": {
              "name": "storage.type.ghost"
            },
            "3": {
              "name": "entity.name.function.ghost"
            }
          }
        }
      ]
    },
    "function-call": {
      "comment": "standalone function call: name(...)",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.ghost"
        }
      }
    },
    "method-call": {
      "comment": "method call on object: obj.method(...)",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\.(get|post|put|del|route|listen|serve|display|loadCSV)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "variable.other.object.ghost"
        },
        "2": {
          "name": "entity.name.function.member.ghost"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ghost",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ghost",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ghost",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.ghost",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.ghost",
          "match": "(?<!=)=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.ghost",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.logical.ghost",
          "match": "(&&|\\|\\||!)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.ghost",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.ghost",
          "match": ","
        },
        {
          "name": "punctuation.definition.block.ghost",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.parameters.ghost",
          "match": "[()]"
        }
      ]
    }
  }
}