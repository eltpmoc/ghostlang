# Compila um .g que tem erro e confere a mensagem do compilador (c42: arquivo:linha:coluna, codigo GHOST-Exxxx e trecho).
# Uso: cmake -DGHOST=<ghost.exe> -DSOURCE=<arquivo.g> -DEXPECT=<trechos esperados> -DWORK=<pasta> -P run_diag_test.cmake
get_filename_component(srcdir "${SOURCE}" DIRECTORY)
get_filename_component(name "${SOURCE}" NAME_WE)
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${GHOST}" "${name}.g" -o "${WORK}/${name}.exe" WORKING_DIRECTORY "${srcdir}"
                OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc ENCODING UTF-8)
if(rc EQUAL 0)
  message(FATAL_ERROR "${SOURCE} deveria falhar, mas compilou")
endif()
file(STRINGS "${EXPECT}" lines ENCODING UTF-8)
set(missing 0)
foreach(line IN LISTS lines)
  if(NOT line STREQUAL "")
    string(FIND "${err}" "${line}" pos)
    if(pos EQUAL -1)
      message(SEND_ERROR "Trecho esperado nao encontrado: ${line}")
      math(EXPR missing "${missing}+1")
    endif()
  endif()
endforeach()
if(missing GREATER 0)
  message(FATAL_ERROR "Saida do compilador:\n${err}")
endif()
message(STATUS "diagnostico ${name}: OK")
