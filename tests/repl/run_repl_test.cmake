# Roda o REPL (ghost sem argumentos) com um roteiro na entrada padrao e confere trechos esperados.
# Uso: cmake -DGHOST=<ghost.exe> -DINPUT=<roteiro> -DEXPECT=<arquivo de trechos> -P run_repl_test.cmake
execute_process(COMMAND "${GHOST}" INPUT_FILE "${INPUT}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc ENCODING UTF-8)
set(all "${out}${err}")
file(STRINGS "${EXPECT}" lines ENCODING UTF-8)
set(missing 0)
foreach(line IN LISTS lines)
  if(NOT line STREQUAL "")
    string(FIND "${all}" "${line}" pos)
    if(pos EQUAL -1)
      message(SEND_ERROR "Trecho esperado nao encontrado: ${line}")
      math(EXPR missing "${missing}+1")
    endif()
  endif()
endforeach()
# Um erro de execucao que o roteiro nao espera reprova o teste (antes passava despercebido
# se os trechos esperados aparecessem em outras linhas).
# Um erro conta como esperado quando algum trecho do arquivo EXPECT aparece na linha dele.
string(REPLACE ";" "," all_sem_pv "${all}")
string(REGEX MATCHALL "\\[Erro[^\n]*" erros "${all_sem_pv}")
foreach(e IN LISTS erros)
  set(previsto FALSE)
  foreach(line IN LISTS lines)
    string(REPLACE ";" "," line_sem_pv "${line}")
    if(NOT line_sem_pv STREQUAL "")
      string(FIND "${e}" "${line_sem_pv}" p)
      if(NOT p EQUAL -1)
        set(previsto TRUE)
      endif()
    endif()
  endforeach()
  if(NOT previsto)
    message(SEND_ERROR "Erro inesperado no REPL: ${e}")
    math(EXPR missing "${missing}+1")
  endif()
endforeach()
if(missing GREATER 0)
  message(FATAL_ERROR "Saida do REPL:\n${all}")
endif()
message(STATUS "REPL OK")
