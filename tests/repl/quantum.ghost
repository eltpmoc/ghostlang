// Roteiro do REPL quantico (CTest repl_quantum): ghost < tests/repl/quantum.ghost
print(quantum_backend());
qreg q(2);
q.seed(42);
q.h(0); q.cx(0, 1);
print(q);
print(q.draw());
print("P(q0=1) = " + q.prob(0));
print(f"<ZZ> = ${q.expect("ZZ")}  <XX> = ${q.expect("XX")}");
print(q.histogram(1000));
int a = q.measure(0);
int b = q.measure(1);
print(f"medido ${a} ${b} -> ${q}");
show(q);
string desenho = q.draw();
print(desenho);
double pct = q.prob(1) * 100;
print(pct);
q.ry(0, PI / 3);
print(q.ket(3));
qreg g(16);
print(f"qreg(16) em ${g.device_name()}");
qcircuit h2(2);
h2.seed(3);
h2.ansatz(2);
h2.observable("II", -1.052373245772859);
h2.observable("IZ", 0.39793742484318045);
h2.observable("ZI", -0.39793742484318045);
h2.observable("ZZ", -0.01128010425623538);
h2.observable("XX", 0.18093119978423156);
print(f"VQE H2: ${h2.minimize(300, 0.05)} Ha");
qcircuit m(2);
m.seed(5);
m.encode_all();
m.ansatz(2);
for (var i = 0; i < 8; i = i + 1) { for (var j = 0; j < 8; j = j + 1) { double x0 = i / 7.0 * PI; double x1 = j / 7.0 * PI; if (x0 + x1 > PI) { m.add_sample(1, x0, x1); } else { m.add_sample(0, x0, x1); } } }
print(f"amostras ${m.samples()}");
double perda = m.fit(60, 0.1);
print(f"acuracia ${m.accuracy() * 100}%  perda ${perda}");
print(f"predict(0.3,0.5)=${m.predict(0.3, 0.5)} predict(2.8,2.6)=${m.predict(2.8, 2.6)}");
qcircuit grafo(4);
grafo.edge(0, 1); grafo.edge(1, 2); grafo.edge(2, 3); grafo.edge(3, 0);
grafo.qaoa(2);
grafo.minimize(100, 0.05);
string s = grafo.maxcut_solution(1000);
print(f"MaxCut: ${s} corte ${grafo.cut_of(s)} de ${grafo.maxcut_exact()}");
q.foo(1);
q.h(9);
qlayer L(2, 1);
exit
