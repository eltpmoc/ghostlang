import "libs/hardware.g" as qhw;

qhw.qhw_configure("ibm", "token_nao_usado", "ibm_brisbane");

var jid = qhw.qhw_submit("OPENQASM 2.0; qreg q[2]; creg c[2]; h q[0]; cx q[0], q[1]; measure q -> c;", "ibm_brisbane", 1000);
print(qhw.qhw_status(jid));
print(qhw.qhw_get_count(jid, "00") + qhw.qhw_get_count(jid, "11"));
print(qhw.qhw_get_count(jid, "01") + qhw.qhw_get_count(jid, "10"));
print(qhw.qhw_get_count(jid, "00") > 400, " ", qhw.qhw_get_count(jid, "11") > 400);

var j2 = qhw.qhw_submit("OPENQASM 2.0; qreg q[2]; x q[0]; rx(pi) q[1]; measure q -> c;", "", 50);
print(qhw.qhw_summary(j2));

try {
    qhw.qhw_submit("OPENQASM 2.0; qreg q[1]; foo q[0];", "", 10);
} catch (e) {
    print("erro: ", e);
}
