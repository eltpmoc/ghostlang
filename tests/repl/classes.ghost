print("== metodos chamando funcoes ==");
Pilha pilha;
for (int i = 1; i <= 4; i++) {
    pilha.empilhar(i * 10);
}
print("soma ", esvaziar(pilha), " original ainda tem ", pilha.itens.length(), " chamadas ", chamadas);

