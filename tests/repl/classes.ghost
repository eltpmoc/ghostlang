class Fib {
    map<string, int> memo;
    function int calc(int n) {
        if (n < 2) {
            return n;
        }
        if (memo.has(str(n))) {
            return memo[str(n)];
        }
        int v = calc(n - 1) + calc(n - 2);
        memo[str(n)] = v;
        return v;
    }
}
Fib fb;
print("fib(30) = ", fb.calc(30), " memo ", fb.memo.length());
