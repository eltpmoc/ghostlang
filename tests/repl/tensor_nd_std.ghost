import "libs/tensor.g" as t;

var t2d = t.tensor_create_2d(2, 3, 0.0);
print(t.tensor_ndim(t2d));
print(t.tensor_size(t2d));

t.tensor_set_2d(t2d, 0, 0, 1.0);
t.tensor_set_2d(t2d, 0, 1, 2.0);
t.tensor_set_2d(t2d, 0, 2, 3.0);
t.tensor_set_2d(t2d, 1, 0, 4.0);
t.tensor_set_2d(t2d, 1, 1, 5.0);
t.tensor_set_2d(t2d, 1, 2, 6.0);

print(t.tensor_get_2d(t2d, 0, 1));
print(t.tensor_get_2d(t2d, 1, 2));
print(t.tensor_sum(t2d));
print(t.tensor_mean(t2d));

// Reshape 2x3 -> 3x2
var t_reshaped = t.tensor_reshape_2d(t2d, 3, 2);
print(t.tensor_dim(t_reshaped, 0));
print(t.tensor_dim(t_reshaped, 1));

// Transpose 2x3 -> 3x2
var t_transposed = t.tensor_transpose_2d(t2d);
print(t.tensor_get_2d(t_transposed, 1, 0));

// MatMul: (2x3) x (3x2) -> (2x2)
var t_mm = t.tensor_matmul(t2d, t_transposed);
print(t.tensor_get_2d(t_mm, 0, 0));

// Broadcasting: Tensor (2x3) + Tensor (1x3)
var t_row = t.tensor_create_2d(1, 3, 10.0);
var t_bcast = t.tensor_add(t2d, t_row);
print(t.tensor_get_2d(t_bcast, 0, 0));
print(t.tensor_get_2d(t_bcast, 1, 2));
