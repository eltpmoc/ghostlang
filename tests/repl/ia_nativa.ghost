var mg = matrix_g(2, 2);
mg.set(0, 1, ghost(1.5, 2.0, 0.5, 0.25));
// GhostMatrixG guarda GhostQubit (real, imag, theta): a componente p nao e guardada
print("matrix_g: ", mg.get(0, 1), " bytes=", mg.size_bytes());
var tr = transformer_model(32, 16, 2, 1, 2, 7);
