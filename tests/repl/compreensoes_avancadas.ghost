// Compreensoes avancadas: compreensao de mapa {k: v for ...}, de conjunto {expr for ...},
// varios 'for' na mesma compreensao, filtros 'if' multiplos, for k, v in mapa e conversao de list<T>.

print("== compreensao de lista com varios for e ifs ==");
list<int> xs = [1, 2, 3];
list<int> ys = [10, 20];
list<int> produtos = [x * y for x in xs for y in ys if x > 1 if y == 20];
print("produtos: ", produtos);

list<string> pares = [f"${x}:${y}" for x in ["a", "b"] for y in [1, 2]];
print("pares: ", pares);

print("== compreensao de conjunto ==");
set<int> numsSet = {x % 3 for x in [1, 2, 3, 4, 5, 6, 7]};
print("numsSet: ", numsSet);

set<string> tags = {w for w in ["ia", "quantica", "ia", "ghost", "quantica"]};
print("tags: ", tags);

set<int> setMulti = {x + y for x in [1, 2] for y in [10, 20] if x + y > 15};
print("setMulti: ", setMulti);

print("== compreensao de mapa ==");
list<string> frutas = ["maca", "banana", "uva"];
map<string, int> tamanhos = {f: f.length() for f in frutas};
print("tamanhos: ", tamanhos["maca"], " ", tamanhos["banana"], " ", tamanhos["uva"]);

map<string, int> matrizPos = {f"${i},${j}": i * 10 + j for i in [1, 2] for j in [1, 2]};
print("pos 1,2: ", matrizPos["1,2"], " pos 2,1: ", matrizPos["2,1"]);

print("== for chave, valor in mapa ==");
map<string, int> estoque = {"caneta": 5, "caderno": 12, "lapis": 3};
map<string, int> destacados = {f"item_${k}": v * 2 for k, v in estoque if v >= 5};
print("destacados caneta: ", destacados["item_caneta"], " caderno: ", destacados["item_caderno"]);

list<string> resumo = [f"${k}=${v}" for k, v in estoque if v < 10];
print("resumo estoque baixo: ", resumo.length());

print("== listas e colecoes ==");
list<int> inteiros = [1, 2, 3];
print("inteiros: ", inteiros);

list<string> textos = ["10", "true", "3.14"];
print("textos: ", textos);

print("fim compreensoes avancadas");

// ---- só no REPL: conversao de elementos de list<T> e erros ----
print("== conversao no REPL ==");
list<int> convInt = [1.9, 2.1, 3.8];
print("convInt: ", convInt);

list<string> convStr = [10, true, 3.14];
print("convStr: ", convStr);

print("== erros de uso ==");
list<int> errElem = ["texto"];
set<int> errSet = {"oi" for x in [1]};
