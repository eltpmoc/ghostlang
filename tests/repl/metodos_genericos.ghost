    function string rotulo<T>() {
        return "x";
    }
}
class CtorGenerico {
    function CtorGenerico<T>() {
    }
}
print(Registro.anotar("x", 1));
print(r.maior(3, 5.5));
print(r.ultimoOu());
print(r.anotar<int, int>("x", 1));
print(Registro.maior(1, 2), " ", r.maior(8, 3));
print("fim do roteiro de metodos genericos");
