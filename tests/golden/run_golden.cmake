# Compila um programa .g com o ghost, roda o executavel e compara a saida com o arquivo esperado (exato).
# Uso: cmake -DGHOST=<ghost.exe> -DSOURCE=<prog.g> -DEXPECT=<prog.expected> -DWORK=<pasta> -P run_golden.cmake
get_filename_component(name "${SOURCE}" NAME_WE)
file(MAKE_DIRECTORY "${WORK}")
set(suffix "")
if(CMAKE_HOST_WIN32)
  set(suffix ".exe")
endif()
set(exe "${WORK}/${name}${suffix}")
file(REMOVE "${exe}")
get_filename_component(srcdir "${SOURCE}" DIRECTORY)
execute_process(COMMAND "${GHOST}" "${SOURCE}" -o "${exe}" WORKING_DIRECTORY "${srcdir}"
                OUTPUT_VARIABLE cout ERROR_VARIABLE cerr RESULT_VARIABLE crc)
if(NOT EXISTS "${exe}")
  message(FATAL_ERROR "Falhou ao compilar ${SOURCE} (rc=${crc}):\n${cout}\n${cerr}")
endif()
execute_process(COMMAND "${exe}" OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc TIMEOUT 120 ENCODING UTF-8)
string(REPLACE "\r" "" out "${out}")
file(READ "${EXPECT}" expected)
string(REPLACE "\r" "" expected "${expected}")
if(NOT out STREQUAL expected)
  file(WRITE "${WORK}/${name}.actual" "${out}")
  message(FATAL_ERROR "Saida diferente do esperado (${EXPECT}).\nObtido em ${WORK}/${name}.actual:\n${out}\nstderr:\n${err}")
endif()
message(STATUS "golden ${name}: OK")
