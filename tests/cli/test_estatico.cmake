# ghost build sem -d gera executavel estatico no Windows: so pode importar DLLs do sistema.
# Uso: cmake -DGHOST=<ghost.exe> -DSOURCE=<prog.g> -DWORK=<pasta> -DOBJDUMP=<objdump> -P test_estatico.cmake
file(MAKE_DIRECTORY "${WORK}")
set(exe "${WORK}/estatico_teste.exe")
file(REMOVE "${exe}")
execute_process(COMMAND "${GHOST}" build "${SOURCE}" -o "${exe}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT EXISTS "${exe}")
  message(FATAL_ERROR "ghost build falhou:\n${out}${err}")
endif()
execute_process(COMMAND "${OBJDUMP}" -p "${exe}" OUTPUT_VARIABLE dump RESULT_VARIABLE rc2)
if(NOT rc2 EQUAL 0)
  message(FATAL_ERROR "objdump falhou")
endif()
string(REGEX MATCHALL "DLL Name: [^\r\n]+" dlls "${dump}")
set(proibidas 0)
foreach(d IN LISTS dlls)
  string(TOLOWER "${d}" dl)
  message(STATUS "${d}")
  if(dl MATCHES "libstdc|libgcc|libgomp|libwinpthread|libssp|libquadmath|libopenblas")
    message(SEND_ERROR "Dependencia do MinGW no executavel: ${d}")
    math(EXPR proibidas "${proibidas}+1")
  endif()
endforeach()
if(proibidas GREATER 0)
  message(FATAL_ERROR "O executavel nao e estatico")
endif()
# e roda numa pasta sem o MinGW no PATH
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=C:/Windows/System32;C:/Windows" "${exe}" RESULT_VARIABLE rc3 OUTPUT_VARIABLE out3 ERROR_VARIABLE err3)
if(NOT rc3 EQUAL 0)
  message(FATAL_ERROR "O executavel nao rodou sem o MinGW no PATH (rc=${rc3}):\n${out3}${err3}")
endif()
message(STATUS "Estatico OK: ${out3}")
